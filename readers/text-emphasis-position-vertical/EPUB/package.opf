  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/">
    <dc:identifier id="pub-id">text-emphasis-position-vertical</dc:identifier>
    <dc:title>Emphasis mark position in vertical Japanese text</dc:title>
    <dc:language>en</dc:language>
    <dc:creator>W3C Internationalization Working Group</dc:creator>
    <dc:publisher>W3C</dc:publisher>
    <dc:date>2026-09-16</dc:date>
    <dc:description>Checks that text-emphasis-position: over right draws the emphasis dot to the right of each character in a vertical-rl line of Japanese text.</dc:description>
    <dc:coverage>Internationalization</dc:coverage>
